# Lemlist API key from https://app.lemlist.com/settings/integrations
LEMLIST_API_KEY=your_lemlist_api_key

# MongoDB connection string
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=Cluster0
MONGODB_DB=lemlist-tracker

# Public URL for webhooks (use ngrok URL in local dev)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Auth session signing secret (login / signup)
AUTH_SECRET=generate_a_long_random_string

# Shared secret required to open public board URLs
BOARD_ACCESS_SECRET=generate_another_random_string
